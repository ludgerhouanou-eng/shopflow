# ===================================================
# SHOPFLOW - CONFIGURATION DES VARIABLES D'ENVIRONNEMENT
# ===================================================

# 1. CONFIGURATION DE L'APPLICATION
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_CURRENCY="XOF"
NODE_ENV="development"

# 2. BASE DE DONNÉES & AUTHENTIFICATION SUPABASE
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# 3. FOURNISSEUR DE PAIEMENT (ADAPTATEUR)
# Options disponibles: 'sandbox' | 'feexpay' | 'kkiapay' | 'fedapay'
PAYMENT_PROVIDER="sandbox"
PAYMENT_API_KEY="sb_api_key_mock_12345"
PAYMENT_SECRET_KEY="sb_sec_key_mock_67890"
PAYMENT_WEBHOOK_SECRET="whsec_mock_abcdef123456789"
PAYMENT_BASE_URL="https://api.sandbox-payment.com/v1"

# 4. SERVICE DE NOTIFICATION (MOCK OU RESEND)
NOTIFICATION_PROVIDER="mock"
RESEND_API_KEY="re_123456789"
DEFAULT_FROM_EMAIL="ShopFlow <noreply@shopflow.bj>"

# 5. WHATSAPP & SMS (TWILIO EXTENSION OPTIONNELLE)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_NUMBER=""

# 6. LOGS ET SÉCURITÉ
LOG_LEVEL="info"
